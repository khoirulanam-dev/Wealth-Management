# WEALTH OS — Environment Configuration Template

# Database Connection (Neon PostgreSQL)
# For serverless, use the connection string with the `-pooler` suffix
DATABASE_URL="postgresql://user:password@ep-cool-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Session Secret (minimum 32 characters random string)
AUTH_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"

# Single Private User Initial Setup
# Used to seed/authorize the single private owner
APP_USER_EMAIL="user@wealthos.local"
APP_USER_PASSWORD="ChangeMeImmediately123!"

# Default Reporting Currency
DEFAULT_CURRENCY="IDR"

# Optional App Environment
NODE_ENV="development"

